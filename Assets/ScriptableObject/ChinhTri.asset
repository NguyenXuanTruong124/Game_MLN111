  m_Script: {fileID: 11500000, guid: 74fb8dbf0f3869d46a35140db62f54b7, type: 3}
  m_Name: ChinhTri
  m_EditorClassIdentifier: Assembly-CSharp::NPCData
  npcName: ChinhTriGia
  question: "Vi\u1EC7t Nam s\u1EED d\u1EE5ng c\xE1c ch\xEDnh s\xE1ch ph\xE1p lu\u1EADt
    v\xE0 c\xF4ng ngh\u1EC7 l\xE0m \"\u0111\xF2n b\u1EA9y\" \u0111\u1EC3 th\xFAc
    \u0111\u1EA9y kinh t\u1EBF. X\xE9t theo quy lu\u1EADt bi\u1EC7n ch\u1EE9ng, hi\u1EC7n
    t\u01B0\u1EE3ng \"\u0111\xF2n b\u1EA9y\" n\xE0y minh ch\u1EE9ng cho \u0111i\u1EC1u
    g\xEC?"
  answers:
  - "S\u1EF1 quy\u1EBFt \u0111\u1ECBnh tuy\u1EC7t \u0111\u1ED1i v\xE0 th\u1EE5 \u0111\u1ED9ng
    c\u1EE7a c\u01A1 c\u1EA5u kinh t\u1EBF \u0111\u1ED1i v\u1EDBi m\u1ECDi s\u1EF1
    thay \u0111\u1ED5i c\u1EE7a h\u1EC7 th\u1ED1ng ph\xE1p lu\u1EADt."
  - "T\xEDnh \u0111\u1ED9c l\u1EADp t\u01B0\u01A1ng \u0111\u1ED1i v\xE0 s\u1EE9c
    m\u1EA1nh t\xE1c \u0111\u1ED9ng tr\u1EDF l\u1EA1i m\u1ED9t c\xE1ch ch\u1EE7 \u0111\u1ED9ng
    c\u1EE7a Ki\u1EBFn tr\xFAc th\u01B0\u1EE3ng t\u1EA7ng l\xEAn C\u01A1 s\u1EDF
    h\u1EA1 t\u1EA7ng."
  correctAnswerIndex: 1
